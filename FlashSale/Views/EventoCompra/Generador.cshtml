@{
    ViewData["Title"] = "Generador de Eventos";
}

<h2>Generador de Eventos</h2>

<form>

    <div class="mb-3">
        <label>Producto</label>
        <select class="form-control">
            <option>Laptop Gamer</option>
        </select>
    </div>

    <div class="mb-3">
        <label>Modo</label><br />

        <input type="radio" checked />
        Individual

        <br />

        <input type="radio" />
        Masivo
    </div>

    <div class="mb-3">
        <label>Cantidad por compra</label>

        <input class="form-control"
               type="number"
               value="1" />
    </div>

    <div class="mb-3">
        <label>Cantidad de eventos</label>

        <input class="form-control"
               type="number"
               value="1000" />
    </div>

    <button class="btn btn-success">

        Generar Eventos

    </button>

</form>