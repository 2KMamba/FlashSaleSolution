@model FlashSale.DTOs.GeneradorMasivoDTO

@{
    ViewData["Title"] = "Generador de Eventos";
}

<h2>Generador de Eventos</h2>

@if (ViewBag.Mensaje != null)
{
    <div class="alert alert-success">
        @ViewBag.Mensaje
    </div>
}

<form asp-action="Generador" method="post">

    <div class="mb-3">
        <label>Producto</label>

        <select asp-for="ProductoId" class="form-select">

            @foreach (var producto in ViewBag.Productos)
            {
                <option value="@producto.Id">
                    @producto.Nombre
                </option>
            }

        </select>
    </div>

    <div class="mb-3">

        <label class="form-label">Modo</label>

        <div class="form-check">
            <input class="form-check-input"
                   type="radio"
                   asp-for="Modo"
                   value="Individual" />

            <label class="form-check-label">
                Individual
            </label>
        </div>

        <div class="form-check">
            <input class="form-check-input"
                   type="radio"
                   asp-for="Modo"
                   value="Masivo" />

            <label class="form-check-label">
                Masivo
            </label>
        </div>

    </div>

    <div class="mb-3">
        <label>Cantidad por compra</label>

        <input asp-for="CantidadPorCompra"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>Cantidad de eventos</label>

        <input asp-for="CantidadEventos"
               class="form-control" />
    </div>

    <button type="submit"
            class="btn btn-success">
        Generar Eventos
    </button>

</form>